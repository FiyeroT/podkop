FROM itdoginfo/openwrt-sdk-ipk:24.10.6

ARG PODKOP_VERSION
# the packages to build: CI builds podkop for each architecture apart (sdk/build.sh) and
# takes only the page from here
ARG PACKAGES="podkop luci-app-podkop"

COPY ./sdk/golang-feed.sh /builder/golang-feed.sh
RUN sh /builder/golang-feed.sh

COPY ./podkop /builder/package/feeds/utilities/podkop
COPY ./src/backend /builder/package/feeds/utilities/podkop/src/backend
COPY ./luci-app-podkop /builder/package/feeds/luci/luci-app-podkop

RUN export PODKOP_VERSION="v${PODKOP_VERSION}" && \
    make defconfig && \
    for p in ${PACKAGES}; do make package/$p/compile V=s -j4 || exit 1; done
